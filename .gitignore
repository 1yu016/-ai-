# Runtime databases and generated data
backend/data/*.sqlite
backend/data/*.sqlite-shm
backend/data/*.sqlite-wal
backend/data/*.sqlite.bak-*
backend/data/*.bak-*
backend/uploads/resources/*
!backend/uploads/resources/.gitkeep
backend/uploads/avatars/*
!backend/uploads/avatars/.gitkeep
backend/uploads/artworks/*
!backend/uploads/artworks/.gitkeep

# Logs and test output
**/*.log
frontend/playwright-report/
frontend/test-results/
frontend/.tmp/
/.tmp/

# Local media and temporary working files
test-resources/*
!test-resources/.gitkeep
temp-audio-work/
.tools/
.ppt-build/
.codex-finalizer/
output/
Java对象引用工作原理图*.png
local_audio_transcribe.ps1
local_wav_recognize.ps1
.tmp/
.docx-review-content.txt
temp-two-person-docx-render*/
