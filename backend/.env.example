API_KEY=your_deepseek_api_key
PORT=3001

# 个人资源目录；默认也会自动查找项目根目录下的 test-resources
RESOURCE_LIBRARY_PATH=../test-resources
# 资源正式文件和分片临时目录；禁止放到静态 Web 根目录之外
RESOURCE_UPLOAD_PATH=./uploads/resources
RESOURCE_CHUNK_PATH=./uploads/.chunks

# 数字人资源目录及可发布的服务端引擎兼容版本（逗号分隔）
AVATAR_UPLOAD_PATH=./uploads/avatars
AVATAR_SUPPORTED_ENGINE_VERSIONS=avatar-engine-1

# 幼儿作品使用独立受保护目录，不通过静态文件中间件公开
ARTWORK_UPLOAD_PATH=./uploads/artworks
# 必须配置为支持图片输入的视觉模型 endpoint；未配置时接口明确返回能力不可用
ARTWORK_VISION_MODEL=your_ark_vision_endpoint_id
ARTWORK_VISION_TIMEOUT_MS=30000

# 教师登录与本地 SQLite 数据库
DATABASE_PATH=./data/app.sqlite
DB_MIGRATIONS_RUN=true
# 兼容现有开发库可保持 true；生产库完成迁移验证后建议设置为 false
DB_SYNCHRONIZE=true
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# 开发环境测试教师；首次启动时自动创建，密码只保存 bcrypt 哈希
TEST_TEACHER_ACCOUNT=teacher_demo
TEST_TEACHER_PASSWORD=Teacher123!
TEST_TEACHER_NAME=测试老师

# 首次部署管理员；创建后应从运行环境中移除密码
INITIAL_ADMIN_ACCOUNT=admin
INITIAL_ADMIN_PASSWORD=ChangeThisAdminPassword!
INITIAL_ADMIN_NAME=系统管理员
INITIAL_ADMIN_SCHOOL_ID=default-kindergarten

# 单园部署共享资源的保留 ownerId；仅 approved 状态对教师可见
GARDEN_SHARED_OWNER_ID=garden:shared

# 游客临时数据保留天数及公开接口限流
VISITOR_RETENTION_DAYS=14
PUBLIC_RATE_TTL_MS=60000
PUBLIC_RATE_LIMIT=20
CLASSROOM_MOBILE_SESSION_TTL_MS=28800000
DEVICE_HEARTBEAT_TIMEOUT_MS=90000
# 局域网部署时填写教师手机可访问的服务端地址，例如 http://192.168.1.20:3001
CLASSROOM_LAN_BASE_URL=

# 大屏超过该秒数没有心跳即判定为离线
DEVICE_HEARTBEAT_TIMEOUT_SECONDS=90

# 火山引擎新版控制台 API Key（ASR 2.0、TTS 2.0 共用）
VOLC_API_KEY=your_volc_api_key

# 豆包语音合成模型 2.0 资源和“儿童绘本”音色
VOLC_TTS_RESOURCE_ID=seed-tts-2.0
VOLC_TTS_VOICE_TYPE=zh_female_xueayi_saturn_bigtts

# 火山方舟豆包文本模型；复杂教案生成通常需要更长响应时间
ARK_API_KEY=your_ark_api_key
ARK_ENDPOINT_ID=your_ark_endpoint_id
AI_REQUEST_TIMEOUT_MS=90000
# 问题地图只向模型发送当前有权班级的匿名聚合统计；设为 false 时使用安全规则建议。
QUESTION_MAP_AI_ENABLED=true
CLASSROOM_SUMMARY_AI_ENABLED=true
CLASSROOM_SUMMARY_AI_TIMEOUT_MS=8000
